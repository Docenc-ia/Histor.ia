# ============================================================================
# Docenc.ia - Configuración de Variables de Entorno (Plantilla de Ejemplo)
# ============================================================================
# IMPORTANTE:
# 1. Nunca subas claves privadas reales ni archivos .env al repositorio.
# 2. En producción (Vercel / Cloud Run), configura estas variables en el panel
#    de Environment Variables del proveedor de hosting.

# ID de Cliente OAuth 2.0 Web de Google Cloud Console (público para flujo GIS implícito en navegador)
VITE_GOOGLE_CLIENT_ID=tu_client_id_de_google_cloud.apps.googleusercontent.com

# Clave de API de Gemini (exclusivamente del lado servidor; nunca usar prefijo VITE_)
GEMINI_API_KEY=
