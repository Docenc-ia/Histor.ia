rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check test connection document
    match /test/connection {
      allow read, write: if true;
    }

    // Teacher user profile and all nested subcollections (courses, students, attendance, disposition, snapshots)
    match /users/{userId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
  }
}
